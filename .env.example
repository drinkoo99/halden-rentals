# Copy to .env.local and fill in. Never commit real values (.env* files other than this one are git-ignored).
# Server variables are validated at runtime by src/server/config/env.ts; see docs/BACKEND.md.

# Public base URL used for metadata, sitemap and robots (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend (Phase 2) ---------------------------------------------------------------

# MongoDB connection string (Atlas: Database > Connect > Drivers). Optional until pages read from
# the database; without it, /api/v1/health reports the database as "not_configured".
# Use a development/staging cluster locally — never production credentials.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (default: halden_dev). Names containing "prod" are treated as
# production by `npm run db:setup`, which then refuses to apply changes without --allow-production.
# MONGODB_DB=halden_dev

# Server log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Planned (later milestones, not used yet):
# AUTH_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=
# CRON_SECRET=
