# Copy to .env.local and fill in. Never commit real values (.env* files other than this one are git-ignored).
# Server variables are validated at runtime by src/server/config/env.ts; see docs/BACKEND.md.

# Public base URL used for metadata, sitemap and robots (no trailing slash). REQUIRED in production
# (VERCEL_ENV=production); previews fall back to their deployment URL, everything else to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend (Phase 2) ---------------------------------------------------------------

# MongoDB connection string (Atlas: Database > Connect > Drivers). REQUIRED in production. Optional in
# development and CI: without it, pages render the static demo catalogue (with a logged warning), the
# catalogue API answers 503 and /api/v1/health reports the database as "not_configured".
# Server-only (never prefix with NEXT_PUBLIC_). Use a development/staging cluster locally — never
# production credentials.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster (default: halden_dev; REQUIRED explicitly in production). Names containing "prod" are treated as
# production by `npm run db:setup` and `npm run db:seed`, which then refuse to apply changes without
# --allow-production.
# MONGODB_DB=halden_dev

# Integration-test database for `npm run test:integration` (default: halden_test). Must be halden_test or
# halden_test_<suffix> and differ from MONGODB_DB; anything else aborts the test run.
# MONGODB_TEST_DB=halden_test

# Server log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Transactional email via Resend (https://resend.com, free tier). Set BOTH to enable password-reset and
# email-verification emails; without them the app says plainly that email is unavailable. Server-only.
# RESEND_API_KEY=re_...
# EMAIL_FROM=HALDEN <concierge@your-verified-domain.example>

# One-way return fee in whole euros (default 0 = no fee). The business has not set one yet.
# ONE_WAY_FEE_EUR=0

# Planned (later milestones, not used yet):
# CRON_SECRET=
